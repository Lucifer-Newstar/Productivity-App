{
  "name": "@kaizen/intelligence-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent local-first Kaizen Intelligence Engine",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "qa:wave0": "python wave0/scripts/qa_wave0.py"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
